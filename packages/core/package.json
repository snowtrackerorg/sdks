{
  "name": "@snowtrackerpro/sdk-core",
  "version": "0.0.1",
  "description": "Core client for the SnowTracker.pro SDKs (publishable-key auth).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowtrackerorg/sdks.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/snowtrackerorg/sdks/tree/main/packages/core#readme",
  "keywords": [
    "snowtracker",
    "sdk"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}

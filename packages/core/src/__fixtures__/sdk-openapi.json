{
  "servers": [
    {
      "description": "This API",
      "url": "/v1"
    }
  ],
  "paths": {
    "/sdk/forms": {
      "get": {
        "operationId": "sdk-get-default-form",
        "parameters": [
          {
            "description": "Which default form to resolve.",
            "explode": false,
            "in": "query",
            "name": "kind",
            "schema": {
              "default": "quote",
              "description": "Which default form to resolve.",
              "enum": ["quote", "contact"],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SDKFormBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Default form schema by kind for embeddable SDKs (publishable-key auth).",
        "tags": ["sdk"]
      }
    },
    "/sdk/forms/{form_id}": {
      "get": {
        "operationId": "sdk-get-form",
        "parameters": [
          {
            "in": "path",
            "name": "form_id",
            "required": true,
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SDKFormBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Form schema by id for embeddable SDKs (publishable-key auth).",
        "tags": ["sdk"]
      }
    },
    "/sdk/leads": {
      "post": {
        "operationId": "sdk-create-lead",
        "parameters": [
          {
            "description": "Recorded on the submission for audit.",
            "in": "header",
            "name": "Origin",
            "schema": {
              "description": "Recorded on the submission for audit.",
              "type": "string"
            }
          },
          {
            "description": "Recorded on the submission for audit.",
            "in": "header",
            "name": "User-Agent",
            "schema": {
              "description": "Recorded on the submission for audit.",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SDKLeadInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SDKLeadBody"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Submit a lead from an embedded form (publishable-key auth, quotes:create scope).",
        "tags": ["sdk"]
      }
    },
    "/sdk/tracking": {
      "get": {
        "description": "Readable by anyone holding one of the tenant's publishable keys, so it carries no names, addresses, stops or counts. 404 unless the tenant has switched the public live map on. Poll no faster than every 5 seconds; the path is rate limited per IP (429 + Retry-After).",
        "operationId": "sdk-tracking",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SDKTrackingBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [],
        "summary": "Public live map: tractors currently out on a route (publishable-key auth, tracking:read scope).",
        "tags": ["sdk"]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": ["/v1/ErrorModel.json"],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": ["Property foo is required but is missing."],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": ["array", "null"]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": ["https://example.com/error-log/abc123"],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [400],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": ["Bad Request"],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": ["https://example.com/errors/example"],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "MergedField": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "maps_to": {
            "type": "string"
          },
          "max_len": {
            "format": "int64",
            "type": "integer"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "type": ["array", "null"]
          },
          "required": {
            "type": "boolean"
          },
          "type": {
            "type": "string"
          }
        },
        "required": ["key", "type", "label", "required", "max_len"],
        "type": "object"
      },
      "Option": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": ["value", "label"],
        "type": "object"
      },
      "SDKCaptchaBody": {
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string"
          },
          "sitekey": {
            "type": "string"
          }
        },
        "required": ["provider", "sitekey"],
        "type": "object"
      },
      "SDKFormBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": ["/v1/SDKFormBody.json"],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "branding": {
            "$ref": "#/components/schemas/SDKFormBranding"
          },
          "captcha": {
            "$ref": "#/components/schemas/SDKCaptchaBody"
          },
          "catalog_version": {
            "format": "int64",
            "type": "integer"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/MergedField"
            },
            "type": ["array", "null"]
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "catalog_version",
          "fields",
          "branding",
          "captcha",
          "token"
        ],
        "type": "object"
      },
      "SDKFormBranding": {
        "additionalProperties": false,
        "properties": {
          "logo_url": {
            "type": "string"
          },
          "primary_hex": {
            "type": "string"
          },
          "tenant_name": {
            "type": "string"
          }
        },
        "required": ["tenant_name", "logo_url", "primary_hex"],
        "type": "object"
      },
      "SDKLeadBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": ["/v1/SDKLeadBody.json"],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "submission_id": {
            "type": "string"
          }
        },
        "required": ["submission_id", "status"],
        "type": "object"
      },
      "SDKLeadInputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": ["/v1/SDKLeadInputBody.json"],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "captcha_token": {
            "description": "Turnstile response token, required when the form schema carries a captcha block.",
            "maxLength": 4096,
            "type": "string"
          },
          "extra": {
            "additionalProperties": {},
            "description": "Bounded escape hatch: ≤10 keys, ≤1KB each, archived verbatim.",
            "type": "object"
          },
          "fields": {
            "additionalProperties": {},
            "description": "Catalog-keyed answers. Unknown keys are rejected (422 naming the key).",
            "type": "object"
          },
          "form_id": {
            "description": "The form this submission answers (from GET /sdk/forms).",
            "maxLength": 64,
            "type": "string"
          },
          "token": {
            "description": "Signed issued-at token from GET /sdk/forms.",
            "maxLength": 512,
            "type": "string"
          },
          "website": {
            "description": "Honeypot — leave empty.",
            "type": "string"
          }
        },
        "required": ["form_id", "fields", "token"],
        "type": "object"
      },
      "SDKTrackingBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": ["/v1/SDKTrackingBody.json"],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "as_of": {
            "description": "When this snapshot was built. Snapshots are shared between viewers for a few seconds.",
            "format": "date-time",
            "type": "string"
          },
          "center": {
            "$ref": "#/components/schemas/SDKTrackingCenter",
            "description": "Where to open the map when no tractor is out: the rough middle of the service area (rounded to ~1 km). Null when the tenant has no routes with located stops."
          },
          "routes": {
            "description": "The tenant's saved routes, in the office's order — for a route picker. Always an array.",
            "items": {
              "$ref": "#/components/schemas/SDKTrackingRoute"
            },
            "type": "array"
          },
          "tractors": {
            "description": "Tractors currently out on a route whose last fix is under 15 minutes old. Always an array; empty when nobody is out.",
            "items": {
              "$ref": "#/components/schemas/SDKTrackingTractor"
            },
            "type": "array"
          }
        },
        "required": ["as_of", "center", "routes", "tractors"],
        "type": "object"
      },
      "SDKTrackingCenter": {
        "additionalProperties": false,
        "properties": {
          "lat": {
            "format": "double",
            "type": "number"
          },
          "lng": {
            "format": "double",
            "type": "number"
          }
        },
        "required": ["lat", "lng"],
        "type": ["object", "null"]
      },
      "SDKTrackingRoute": {
        "additionalProperties": false,
        "properties": {
          "color": {
            "examples": ["#1d4ed8"],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name", "color"],
        "type": "object"
      },
      "SDKTrackingTractor": {
        "additionalProperties": false,
        "properties": {
          "heading_deg": {
            "description": "Degrees clockwise from north; null when the device did not report one.",
            "format": "double",
            "type": ["number", "null"]
          },
          "icon": {
            "description": "Preset icon key. A custom uploaded icon is reported as the vehicle's default preset — never a URL.",
            "enum": [
              "tractor",
              "plow-truck",
              "truck",
              "pickup",
              "snowflake",
              "blower",
              "mower",
              "wrench"
            ],
            "type": "string"
          },
          "id": {
            "description": "Opaque and stable for one run only — it cannot be used to follow a tractor from one day to the next.",
            "type": "string"
          },
          "lat": {
            "format": "double",
            "type": "number"
          },
          "lng": {
            "format": "double",
            "type": "number"
          },
          "recorded_at": {
            "format": "date-time",
            "type": "string"
          },
          "route_id": {
            "description": "Matches an id in routes.",
            "type": "string"
          },
          "vehicle_name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "vehicle_name",
          "icon",
          "route_id",
          "lat",
          "lng",
          "heading_deg",
          "recorded_at"
        ],
        "type": "object"
      }
    }
  }
}

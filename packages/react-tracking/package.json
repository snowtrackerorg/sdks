{
  "name": "@snowtrackerpro/sdk-tracking-react",
  "version": "0.1.0",
  "description": "Drop-in React live map for SnowTracker.pro — show your tractors on your own website, filtered by route.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowtrackerorg/sdks.git",
    "directory": "packages/react-tracking"
  },
  "homepage": "https://github.com/snowtrackerorg/sdks/tree/main/packages/react-tracking#readme",
  "keywords": [
    "snowtracker",
    "sdk",
    "react",
    "live-tracking",
    "google-maps"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@snowtrackerpro/sdk-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/google.maps": "^3.58.1",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
